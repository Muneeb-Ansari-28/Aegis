{
  "taxonomy": "Aegis 8 Core Vulnerability Categories + Unmapped Research",
  "categories": {
    "01_prompt_injection": {
      "name": "Prompt Injection",
      "description": "Manipulating LLM behavior via crafted inputs, direct jailbreaks, indirect document/data injections, and instruction overrides.",
      "sources_represented": [
        "promptfoo",
        "deepteam",
        "garak",
        "pyrit",
        "agentdojo",
        "cyberseceval"
      ],
      "mapped_constructs": {
        "promptfoo": [
          "redteam/plugins/harmful/*",
          "redteam/plugins/jailbreak*",
          "redteam/strategies/*"
        ],
        "deepteam": [
          "vulnerabilities/prompt_injection.py",
          "vulnerabilities/indirect_prompt_injection.py",
          "attacks/single_turn_jailbreak.py"
        ],
        "garak": [
          "probes/promptinject.py",
          "probes/dan.py",
          "probes/atkgen.py",
          "probes/latentinjection.py",
          "data/dan/*.json"
        ],
        "pyrit": [
          "datasets/jailbreak/templates/*.yaml",
          "datasets/jailbreak/many_shot_examples.json",
          "score/*.py"
        ],
        "agentdojo": [
          "runs/* (important_instructions, ignore_previous, direct)"
        ],
        "cyberseceval": [
          "CybersecurityBenchmarks/datasets/prompt_injection/prompt_injection.json"
        ]
      }
    },
